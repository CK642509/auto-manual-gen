{
  "app": {
    "mode": "electron",
    "electron": {
      "projectDir": "apps/demo-stream-app",
      "buildBeforeLaunch": true
    },
    "web": {
      "url": "http://localhost:5173"
    }
  },
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "paths": {
